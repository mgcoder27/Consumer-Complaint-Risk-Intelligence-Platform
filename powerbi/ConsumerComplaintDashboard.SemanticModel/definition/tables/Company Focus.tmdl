	column relief_rate_rank_min_100_outcomes
		dataType: double
		lineageTag: b57bef9c-2d26-58de-839e-081bce5ff9f7
		summarizeBy: sum
		sourceColumn: relief_rate_rank_min_100_outcomes

	partition 'Company Focus-629c2de7-e05c-5dba-8a51-eb0f24fe5826' = m
		mode: import
		source =
			let
				Source = Csv.Document(
					File.Contents(DataFolder & "\company_relief_rates.csv"),
					[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				),
				PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				TypedColumns = Table.TransformColumnTypes(
					PromotedHeaders, {{"company", type text}, {"complaint_count", Int64.Type}, {"closed_outcome_count", Int64.Type}, {"monetary_relief_count", Int64.Type}, {"monetary_relief_rate_pct", type number}, {"complaint_volume_rank", Int64.Type}, {"relief_rate_rank_min_100_outcomes", type number}}
				)
,
				EligibleCompanies = Table.SelectRows(TypedColumns, each [relief_rate_rank_min_100_outcomes] <> null),
				SortedCompanies = Table.Sort(EligibleCompanies, {{"relief_rate_rank_min_100_outcomes", Order.Ascending}}),
				TopCompanies = Table.FirstN(SortedCompanies, 15)
			in
				TopCompanies

	annotation PBI_ResultType = Table
