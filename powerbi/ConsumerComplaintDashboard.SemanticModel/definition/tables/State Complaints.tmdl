	partition 'State Complaints-25892947-c55e-5873-a4c8-b5a5cadb2248' = m
		mode: import
		source =
			let
				Source = Csv.Document(
					File.Contents(DataFolder & "\state_complaints_per_capita.csv"),
					[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				),
				PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				TypedColumns = Table.TransformColumnTypes(
					PromotedHeaders, {{"state", type text}, {"complaint_count", Int64.Type}, {"closed_outcome_count", Int64.Type}, {"monetary_relief_count", Int64.Type}, {"monetary_relief_rate_pct", type number}, {"population", Int64.Type}, {"complaints_per_100k", type number}, {"complaint_rate_rank", type number}, {"relief_rate_rank_min_100_outcomes", type number}}
				)
			in
				TypedColumns

	annotation PBI_ResultType = Table
