# Keep locally downloaded or generated CFPB complaint data out of Git.
data/raw/*.csv
data/processed/*.csv
data/processed/baseline/
data/processed/transformer/
data/processed/risk_model/

# Keep Power BI Desktop caches and user-specific settings out of Git.
powerbi/**/*.pbi/localSettings.json
powerbi/**/*.pbi/cache.abf

# Keep Python and Jupyter-generated files out of Git.
__pycache__/
*.py[cod]
.ipynb_checkpoints/
