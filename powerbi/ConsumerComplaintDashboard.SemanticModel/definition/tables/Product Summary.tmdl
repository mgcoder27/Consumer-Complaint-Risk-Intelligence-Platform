table 'Product Summary'
	lineageTag: 8a50d8ac-0745-5fdd-92bc-bdf3218788ae

	measure 'Product Complaints' = SUM('Product Summary'[complaint_count])
		formatString: #,##0
		lineageTag: 5821ce5c-9c57-5102-9e1f-3851ffbbf989

	column product
		dataType: string
		lineageTag: 7d4929e8-877d-571a-bd19-38bbfb5c17af
		summarizeBy: none
		sourceColumn: product

		annotation SummarizationSetBy = User

	column complaint_count
		dataType: int64
		lineageTag: 97e75951-6fee-5afb-b74a-64c47dd46b50
		summarizeBy: sum
		sourceColumn: complaint_count

	column closed_outcome_count
		dataType: int64
		lineageTag: a9c7739c-acc8-5be2-aa0c-4780a8bbda4a
		summarizeBy: sum
		sourceColumn: closed_outcome_count

	column monetary_relief_count
		dataType: int64
		lineageTag: 116556d5-17bc-5a1d-bb64-e69d79669a3d
		summarizeBy: sum
		sourceColumn: monetary_relief_count

	column monetary_relief_rate_pct
		dataType: double
		lineageTag: e80273ce-a4cf-56ed-808e-71cc792a32d2
		summarizeBy: none
		sourceColumn: monetary_relief_rate_pct
		formatString: 0.00

	column complaint_volume_rank
		dataType: int64
		lineageTag: 003d1a3a-3d31-50de-9524-f62acf22cd9c
		summarizeBy: sum
		sourceColumn: complaint_volume_rank

	partition 'Product Summary-0b5b496f-7035-584b-9e92-9032aa9efcd5' = m
		mode: import
		source =
			let
				Source = Csv.Document(
					File.Contents(DataFolder & "\product_summary.csv"),
					[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				),
				PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				TypedColumns = Table.TransformColumnTypes(
					PromotedHeaders, {{"product", type text}, {"complaint_count", Int64.Type}, {"closed_outcome_count", Int64.Type}, {"monetary_relief_count", Int64.Type}, {"monetary_relief_rate_pct", type number}, {"complaint_volume_rank", Int64.Type}}
				)
			in
				TypedColumns

	annotation PBI_ResultType = Table
